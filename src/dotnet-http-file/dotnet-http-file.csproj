<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>dotnet-http-file</AssemblyName>
    <RootNamespace>DotNetHttpFile</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-http-file</ToolCommandName>
    <PackageId>dotnet-http-file</PackageId>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Jaliya Udagedara</Authors>
    <Description>Run Visual Studio .http files from the command line.</Description>
    <PackageTags>http;rest;dotnet-tool;visual-studio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jaliyaudagedara/dotnet-http-file</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jaliyaudagedara/dotnet-http-file.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>
0.2.0
- --name also matches a request's ### title.
- --var name=value sets a variable for the run. It can be repeated.
- -v/--verbose now logs diagnostics to standard error and combines with --show. It no longer means --show full.
- A hint is shown when a request fails with InvalidAuthenticationTokenTenant.
- A Content-Type header on a request without a body is left out quietly.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetHttpFile.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- GenerateResource emits the strongly typed accessor into obj/ during the build; no checked-in Designer file. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace)</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
